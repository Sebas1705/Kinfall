{
  "name": "webgames",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @webgames/web --",
    "build": "npm run build -w @webgames/web",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w @webgames/web --",
    "size": "npm run size -w @webgames/web",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces",
    "golden:update": "node packages/core/scripts/run-ts.mjs scripts/update-golden.ts",
    "golden:runs": "node packages/core/scripts/run-ts.mjs scripts/update-run-golden.ts",
    "bots": "node packages/core/scripts/run-ts.mjs scripts/run-bots.ts",
    "art:preview": "node packages/core/scripts/run-ts.mjs scripts/preview-art.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
